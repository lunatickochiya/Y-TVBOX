<?xml version="1.0" encoding="utf-8"?>
<!-- 频道显示管理: 左栏分组行 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <CheckBox
        android:id="@+id/cbGroupVisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_3"
        android:layout_marginBottom="@dimen/vs_3"
        android:background="@drawable/button_dialog_main"
        android:button="@null"
        android:clickable="true"
        android:drawableLeft="@drawable/selector_checkbox"
        android:drawablePadding="@dimen/vs_10"
        android:ellipsize="marquee"
        android:focusable="true"
        android:padding="@dimen/vs_10"
        android:singleLine="true"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_20"
        android:textStyle="bold" />
</FrameLayout>
