<?xml version="1.0" encoding="utf-8"?>
<!-- 频道显示管理: 双栏, 左侧分组右侧频道, 取消勾选隐藏 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_640"
        android:layout_height="@dimen/vs_640"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_30"
        android:paddingBottom="@dimen/vs_20">

        <TextView
            android:id="@+id/tvVisibilityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:gravity="center"
            android:singleLine="true"
            android:text="频道显示 (取消勾选隐藏)"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0mm"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 左栏: 分组 -->
            <FrameLayout
                android:layout_width="@dimen/vs_260"
                android:layout_height="match_parent">

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/listGroups"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true" />
            </FrameLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="@dimen/vs_1"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_marginRight="@dimen/vs_10"
                android:background="@color/color_000000_60" />

            <!-- 右栏: 当前分组的频道 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/listChannels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvEmptyChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="该分组没有频道"
                    android:textColor="@color/color_FFFFFF_70"
                    android:textSize="@dimen/ts_20"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/checkAll"
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_margin="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="全选"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/clearAll"
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_margin="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="全不选"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/btnConfirm"
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_margin="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_dialog_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="确定"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
